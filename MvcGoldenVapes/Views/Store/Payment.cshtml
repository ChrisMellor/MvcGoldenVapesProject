@{
    ViewData["Title"] = "Payment Page";
}
<h2>@ViewData["Title"] </h2>
<h3>@ViewData["Message"]</h3>

<h2>
    <span>Please Enter Your Payment Details Below:</span>
</h2>

<form action="">
    Full name:<br>
    <input type="text" id="Name" placeholder="Mickey">
    <br>
    Credit Card Number:<br>
    <input type="text" id="CreditCard" placeholder="xxxx-xxxx-xxxx-xxxx" >
    <br>    
    Expiry Date:<br>
    <input type="text" id="ExpiryDate" placeholder="01/17">
    <br>    
    Security Code:<br>
    <input type="text" id="SecurityCode" placeholder="Number on back of card">
    <br>    
    Address1:<br>
    <input type="text" id="Address1" placeholder="117 culverhouse road">
    <br />
    Address2:<br>
    <input type="text" id="Address2" placeholder="Caerau, Cardiff">
    <br />

        <br><br>

    <input type="submit" value="Submit" id="btnValidate" onclick = "return checkPaymentForm()">
</form>


