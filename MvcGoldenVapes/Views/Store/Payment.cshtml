}
<h2>@ViewData["Title"] </h2>
<h3>@ViewData["Message"]</h3>

<h2>
    <span>Please Enter Your Payment Details Below:</span>
</h2>
@using (Html.BeginForm())
{
    @Html.Label("FirstName")<br />
    @Html.TextBox("FirstName")<br />
}
<form action="">
