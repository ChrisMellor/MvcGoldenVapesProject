@model IEnumerable<MvcGoldenVapes.Models.Cart>

@{
    ViewData["Title"] = "Cart";
}
<h2>@ViewData["Title"]</h2>
<h3>@ViewData["Message"]</h3>

<h2>
    <span>Your shopping cart:</span>
</h2>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.VapeName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VapePrice)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SubTotal)


            </th>
        </tr>
    </thead>
    <tbody>

    @foreach (var item in Model)
    {
        <tr>
            <td style="vertical-align:middle;">
                @Html.DisplayFor(modelItem => item.VapeName)
            </td>
            <td style="vertical-align:middle;">
                @Html.DisplayFor(modelItem => item.VapePrice)
            </td>

            <td style="vertical-align:middle;">
                @Html.DisplayFor(modelItem => item.Quantity)
            </td>

            <td style="vertical-align:middle;">
                @Html.DisplayFor(modelItem => item.SubTotal)
            </td>
    </tr>
    }
    </tbody>
    
</table>
<br /> <br /> 

