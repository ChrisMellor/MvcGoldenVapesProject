@{
    ViewData["Title"] = "Cart";
}
<h2>@ViewData["Title"]</h2>
<h3>@ViewData["Message"]</h3>

<h2>
    <span>Your shopping cart:</span>
</h2>

<table>
    <tr>
        <th>
            Product Name
        </th>
        <th>
            Price (each)
        </th>
        <th>
            Quantity
        </th>
        <th>Sub-total</th>

    </tr>

    <tr>
        <td>
            Total
        </td>

        <td id="cart-total" class="text-success"></td>
    </tr>
</table>

<div>

    <button> Clear </buttonstyle>  
    <input type="button" value="Go to Payment" onclick="@("window.location.href='" + @Url.Action("Payment", "Store") + "'");" />

</div>