@model IEnumerable<MvcGoldenVapes.Models.VapeProducts>

@{
    ViewData["Title"] = "Products";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
                <th>
                    @Html.DisplayNameFor(model => model.VapeBrand)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.VapeName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.VapeStock)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.VapePrice)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.VapeSize)
                </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.VapeBrand)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VapeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VapeStock)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VapePrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VapeSize)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.VapeID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.VapeID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.VapeID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
